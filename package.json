{
  "name": "agenttaskservice",
  "version": "0.1.0",
  "description": "A small task service that lets AI agent projects hand TODOs to each other over MCP.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agenttaskservice": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sanitize": "node scripts/sanitize.mjs",
    "check": "npm run typecheck && npm test && npm run sanitize && npm run headers",
    "headers": "node scripts/check-headers.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
