<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for macOS. Replace __NPX__ with the output of `command -v npx`,
     copy to ~/Library/LaunchAgents/, then: launchctl load ~/Library/LaunchAgents/com.example.agenttaskservice.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.agenttaskservice</string>
  <key>ProgramArguments</key>
  <array><string>__NPX__</string><string>--yes</string><string>agenttaskservice</string><string>serve</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
